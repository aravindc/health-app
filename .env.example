# Shared PostgreSQL credentials for health-db and every service that
# connects to it directly via POSTGRES_HOST/PORT/DB/USER/PASSWORD
# (health-db, health-sync, health-mongo-sync, health-api). Each of those
# services lists this file *and* its own directory's .env in docker-compose
# .yml's env_file:, so this is the one place to change the DB password.
#
# tandemdata/.env is the exception: tandemsync needs a full HEALTHDB_URL
# connection string rather than discrete POSTGRES_* vars, so docker-compose
# builds that URL from these same values via variable interpolation (see
# the tandemsync service in docker-compose.yml) instead of duplicating them.
POSTGRES_HOST=health-db
POSTGRES_PORT=5432
POSTGRES_DB=health
POSTGRES_USER=admin
POSTGRES_PASSWORD=your_secure_password
