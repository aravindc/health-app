# Shared PostgreSQL credentials for health-db and every service that
# connects to it via POSTGRES_HOST/PORT/DB/USER/PASSWORD (health-db,
# health-sync, health-mongo-sync, health-tandem-sync, health-api, and
# health-predict's training pipeline). Each service lists this file *and*
# its own directory's .env in docker-compose.yml's env_file:, so this is the
# one place to change the DB password.
POSTGRES_HOST=health-db
POSTGRES_PORT=5432
POSTGRES_DB=health
POSTGRES_USER=admin
POSTGRES_PASSWORD=your_secure_password
