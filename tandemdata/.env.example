TANDEM_USERNAME=your-email@example.com
TANDEM_PASSWORD=your-password

# postgres://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=postgres://user:password@your-postgres-host:5432/tandemdata?sslmode=require

# tandemsync only (cmd/tandemsync): hourly insulin sync into health-db's
# tandem_bolus / tandem_basal tables. Not used by -d / -l / -p. health-db is
# a different database than DATABASE_URL above, which is tandemdata's own.
#
# Running via the root docker-compose.yml: leave this unset. The tandemsync
# service builds HEALTHDB_URL itself from the root .env's POSTGRES_* values
# (see docker-compose.yml) — that way the DB password only lives in one
# place instead of being copied here too.
#
# Running tandemsync standalone (outside docker-compose), set it explicitly:
# HEALTHDB_URL=postgres://user:password@your-postgres-host:5432/health?sslmode=require
# SYNC_INTERVAL_SECONDS=3600
# SYNC_LOOKBACK_HOURS=6
