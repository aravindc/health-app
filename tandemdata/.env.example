TANDEM_USERNAME=your-email@example.com
TANDEM_PASSWORD=your-password

# postgres://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=postgres://user:password@your-postgres-host:5432/tandemdata?sslmode=require

# tandemsync only (cmd/tandemsync): hourly insulin sync into health-db's
# tandem_bolus / tandem_basal tables. Not used by -d / -l / -p. Use the same
# POSTGRES_USER/PASSWORD/DB as health-db/.env in the parent project — see
# that file (health-db is a different service/database than DATABASE_URL
# above, which is tandemdata's own DB).
#
# Running via the root docker-compose.yml (service name "health-db"):
# HEALTHDB_URL=postgres://user:password@health-db:5432/health?sslmode=disable
#
# Running tandemsync standalone against a remote health-db:
HEALTHDB_URL=postgres://user:password@your-postgres-host:5432/health?sslmode=require
# SYNC_INTERVAL_SECONDS=3600
# SYNC_LOOKBACK_HOURS=6
