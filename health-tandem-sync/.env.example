TANDEM_USERNAME=your-email@example.com
TANDEM_PASSWORD=your-password

# health-db connection. Running via the root docker-compose.yml: leave these
# unset here — tandemsync's env_file: list in docker-compose.yml also
# includes the root .env, which already has POSTGRES_HOST/PORT/DB/USER/
# PASSWORD, so the DB password only lives in one place instead of being
# copied here too. Running tandemsync/tandemload standalone (outside
# docker-compose), set them explicitly:
# POSTGRES_HOST=your-postgres-host
# POSTGRES_PORT=5432
# POSTGRES_DB=health
# POSTGRES_USER=admin
# POSTGRES_PASSWORD=your_secure_password
# DB_SSL_MODE=require

# tandemsync only. Each cycle fetches from a watermark (the latest
# timestamp already in health-db's tandem_bolus/tandem_basal/tandem_cgm)
# minus SYNC_OVERLAP_MINUTES, not a fixed lookback — so a longer-than-usual
# gap (tandemsync restarted, was down, etc.) is picked up automatically on
# the next successful cycle. SYNC_LOOKBACK_HOURS is only used as a fallback
# window when those tables are completely empty (e.g. before any tandemload
# has run).
# SYNC_INTERVAL_SECONDS=3600
# SYNC_OVERLAP_MINUTES=15
# SYNC_LOOKBACK_HOURS=6

# Optional: also write every upsert to a second, off-site Postgres instance
# as a backup (e.g. a managed/online database), independent of the local
# health-db container. Leave all of these unset to disable — if you set any
# one of them, all five HOST/PORT/DB/USER/PASSWORD are required. The backup
# write is best-effort: a failure there is logged but doesn't fail a sync
# cycle or load run, since health-db already has the data.
#
# The backup database needs the same schema as health-db — run
# health-db/04-add-tandem-insulin-tables.sql and
# health-db/05-add-tandem-cgm-table.sql against it once; nothing here
# creates the tables automatically.
# BACKUP_POSTGRESQL_HOST=your-backup-postgres-host
# BACKUP_POSTGRESQL_PORT=5432
# BACKUP_POSTGRESQL_DB=health
# BACKUP_POSTGRESQL_USER=backupuser
# BACKUP_POSTGRESQL_PASSWORD=your_backup_password
# BACKUP_DB_SSL_MODE=require
