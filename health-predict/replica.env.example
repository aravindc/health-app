# Credentials for the optional replica Postgres (the health-predict-replica
# service, compose profile predict-replica). Copy to replica.env. The same
# values go in health-predict/.env as TARGET_DB_USER / TARGET_DB_PASSWORD /
# TARGET_DB_NAME, with TARGET_DB_HOST=127.0.0.1 and TARGET_DB_PORT=9086.
POSTGRES_USER=replica
POSTGRES_PASSWORD=change-me
POSTGRES_DB=health_replica
