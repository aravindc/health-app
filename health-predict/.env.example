# health-predict: training pipeline settings. Copy to .env.
# The prediction API (the health-predict compose service) needs none of this:
# it only serves the trained models in models/.

# Which Postgres the pipeline (python -m src.ingest, make daily/update) reads:
#   health-db (default)  health-app's own database, with the POSTGRES_* settings
#                        from health-app's root .env. Use this where health-db
#                        has the full history (the server).
#   replica              a local copy of another health-db kept by dbsync
#                        (TARGET_DB_* below), for training on this machine.
# Switching an existing snapshot needs `python -m src.ingest --full`.
# PREDICT_DB=health-db

# health-db from the host (the root .env's POSTGRES_HOST=health-db only
# resolves inside Docker): health-db's host port from docker-compose.yml.
PREDICT_DB_HOST=127.0.0.1
PREDICT_DB_PORT=9084

# --- Replica only (PREDICT_DB=replica) ---
# dbsync copies SOURCE (e.g. the server's health-db) into TARGET, the
# health-predict-replica service (compose profile predict-replica; its
# credentials are in replica.env, see replica.env.example).
# SOURCE_DB_HOST=12.34.56.78
# SOURCE_DB_PORT=9084
# SOURCE_DB_NAME=sourcedb
# SOURCE_DB_USER=sourceuser
# SOURCE_DB_PASSWORD=sourcepassword
#
# TARGET_DB_HOST=127.0.0.1
# TARGET_DB_PORT=9086
# TARGET_DB_NAME=health_replica
# TARGET_DB_USER=replica
# TARGET_DB_PASSWORD=change-me
#
# Optional dbsync settings
# SOURCE_DB_SSLMODE=prefer            # disable | prefer | require | verify-full
# TARGET_DB_SSLMODE=prefer
# SYNC_SCHEMAS=public                 # comma-separated source schemas
# SYNC_EXCLUDE_TABLES=                # e.g. public.audit_log,public.tmp
# SYNC_WATERMARK_COLUMNS=updated_at,modified_at,last_modified,created_at,inserted_at
# SYNC_TABLE_WATERMARKS=              # per-table override, e.g. public.cgm:ts,public.insulin:ts
#
# The replica's settings prefix (default TARGET):
# T1D_DB_ENV_PREFIX=TARGET
