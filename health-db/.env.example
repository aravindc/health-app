# PostgreSQL credentials for the health-db container itself (official
# postgres image). The same values must also be set in health-sync/.env,
# health-mongo-sync/.env, health-api/.env, and tandemdata/.env (as
# HEALTHDB_URL) since those services connect to this same database — see the
# root README's "Configuration" section for why this is duplicated rather
# than shared from one file.
POSTGRES_HOST=health-db
POSTGRES_PORT=5432
POSTGRES_DB=health
POSTGRES_USER=admin
POSTGRES_PASSWORD=your_secure_password
