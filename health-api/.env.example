# health-api: Go REST API config.
# POSTGRES_* comes from the root .env.example instead of being repeated
# here — health-api's env_file: list in docker-compose.yml includes both.

# Runs as production (gin release mode) unless set to development, which
# turns on gin's debug mode and its verbose route and request logging. Use
# it only for local development. NS_ENV is still read if APP_ENV is unset.
# APP_ENV=development

# Glucose target ranges (mmol/L)
MIN_MMOL=4.0
STRICT_MAX_MMOL=7.0
MEDICAL_MAX_MMOL=10.0

# Optional API key auth (comma-separated); unset disables auth.
# API_KEYS=key1,key2

# Optional browser origins allowed to call the API cross-origin
# (comma-separated, each with scheme, e.g. https://health.example.com).
# Unset uses the defaults: https://ui.health.pers.dev in production, or the
# localhost dev origins when APP_ENV=development. Not needed when the
# frontend reaches the API same-origin (e.g. VITE_API_URL=/api behind a
# reverse proxy).
# CORS_ALLOWED_ORIGINS=https://health.example.com

# Optional proxies (comma-separated IPs/CIDRs) whose X-Forwarded-For the API
# trusts when working out a client's IP for rate limiting. Unset trusts
# loopback and private ranges (the Caddy -> nginx -> API Docker chain), so
# public clients can't spoof their IP; clients on private networks still
# can. Narrow it to your proxy subnet(s) to rule that out.
# TRUSTED_PROXIES=172.18.0.0/16

# Optional: port for the internal Prometheus metrics server (/metrics).
# It isn't published or proxied; scrape http://health-api:9090/metrics from
# a container on health-api's network.
# METRICS_PORT=9090

# Optional: how many days back the API serves data. Unset uses 90; it can
# only be raised (the dashboard's 90-day views need at least that). Older
# data stays in the database but can't be fetched. Restart health-api
# after changing it.
# MAX_HISTORY_DAYS=365
