# health-api: Go REST API config.

# Must match health-db/.env.
POSTGRES_HOST=health-db
POSTGRES_PORT=5432
POSTGRES_DB=health
POSTGRES_USER=admin
POSTGRES_PASSWORD=your_secure_password

NS_ENV=development

# Glucose target ranges (mmol/L)
MIN_MMOL=4.0
STRICT_MAX_MMOL=7.0
MEDICAL_MAX_MMOL=10.0

# Optional API key auth (comma-separated); unset disables auth.
# API_KEYS=key1,key2
