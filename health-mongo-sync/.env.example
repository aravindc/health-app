# health-mongo-sync: one-shot Nightscout MongoDB gap-fill service config.

# Must match health-db/.env.
POSTGRES_HOST=health-db
POSTGRES_PORT=5432
POSTGRES_DB=health
POSTGRES_USER=admin
POSTGRES_PASSWORD=your_secure_password

# MongoDB gap-fill source
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=nightscout
MONGO_COLLECTION=entries
# MONGO_SYNC_LOOKBACK_DAYS=90   # omit to sync all history back to 2020-01-01
